# SEC EDGAR requires a contact email in the User-Agent header of API requests.
# This variable is read directly from the environment (not auto-loaded from a
# .env file) -- set it in your shell before running companyfacts_data_pull.py,
# e.g.:
#   PowerShell: $env:EDGAR_CONTACT_EMAIL = "you@example.com"
#   bash:       export EDGAR_CONTACT_EMAIL=you@example.com
EDGAR_CONTACT_EMAIL=you@example.com
